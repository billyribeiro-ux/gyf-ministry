{
	"name": "gyf-ministry",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"test:unit": "vp test",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.14",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/sofia-sans": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@libsql/client": "^0.17.3",
		"@opentelemetry/api": "^1.10.0",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tabler/icons-svelte": "^3.50.0",
		"@tiptap/core": "^3.32.2",
		"@tiptap/extension-character-count": "^3.32.2",
		"@tiptap/extension-color": "^3.32.2",
		"@tiptap/extension-highlight": "^3.32.2",
		"@tiptap/extension-image": "^3.32.2",
		"@tiptap/extension-link": "^3.32.2",
		"@tiptap/extension-placeholder": "^3.32.2",
		"@tiptap/extension-subscript": "^3.32.2",
		"@tiptap/extension-superscript": "^3.32.2",
		"@tiptap/extension-table": "^3.32.2",
		"@tiptap/extension-table-cell": "^3.32.2",
		"@tiptap/extension-table-header": "^3.32.2",
		"@tiptap/extension-table-row": "^3.32.2",
		"@tiptap/extension-task-item": "^3.32.2",
		"@tiptap/extension-task-list": "^3.32.2",
		"@tiptap/extension-text-align": "^3.32.2",
		"@tiptap/extension-text-style": "^3.32.2",
		"@tiptap/extension-typography": "^3.32.2",
		"@tiptap/extension-underline": "^3.32.2",
		"@tiptap/extension-youtube": "^3.32.2",
		"@tiptap/pm": "^3.32.2",
		"@tiptap/starter-kit": "^3.32.2",
		"@types/node": "^26",
		"@types/sanitize-html": "^2.16.2",
		"@vercel/blob": "^2.8.2",
		"@vitest/browser-playwright": "catalog:",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"gsap": "^3.15.0",
		"mdsvex": "^0.12.7",
		"phosphor-svelte": "^3.1.1",
		"playwright": "^1.60.0",
		"postgres": "^4.0.0",
		"sanitize-html": "^2.18.1",
		"sharp": "~0.34.5",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-meta-tags": "^4.7.0",
		"typescript": "^6.0.3",
		"valibot": "^1.5.0",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^2.1.1",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": [
			"./src/lib/*",
			"./src/lib/*.ts",
			"./src/lib/*/index.ts"
		]
	}
}
